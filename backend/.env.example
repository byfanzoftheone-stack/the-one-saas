# JWT signing secret. In production (ENV=production or RAILWAY_ENVIRONMENT set) the default is refused at startup.
SECRET_KEY=CHANGE_ME_SECRET

# Comma-separated allowlist of frontend origins. "*" is refused; empty = no CORS access.
# Example: https://your-app.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Port is injected automatically by Railway – no need to set this manually
# PORT=8000
