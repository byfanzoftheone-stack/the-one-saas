# Base URL of the Railway backend (no trailing slash)
# Example: https://your-backend.up.railway.app
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# --- Monetization / governance (placeholders only; never commit real values) ---
SECRET_KEY=CHANGE_ME_LONG_RANDOM
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PREMIUM=
# Owner flips to true ONLY after approving live spend/charges. Default: dry-run stubs.
LIVE_ACTIONS_APPROVED=false
# Bearer token for GET /api/audit (leave empty to keep it closed)
ADMIN_TOKEN=

# --- License keys (Stripe webhook -> POST /api/stripe/webhook) ---
# Signing secret from the Stripe dashboard webhook endpoint (whsec_...). Unset => endpoint returns 503.
STRIPE_WEBHOOK_SECRET=
# Path of the license JSON store. UNSET = OS temp dir = EPHEMERAL (lost on restart/serverless). Point at persistent disk.
LICENSE_DB=
